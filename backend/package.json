{
  "name": "codeinsight-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrations.js",
    "seed:admin": "node scripts/seed_admin.js",
    "test": "jest --runInBand --detectOpenHandles --workerIdleMemoryLimit=512MB",
    "test:ci": "jest --runInBand --forceExit --workerIdleMemoryLimit=512MB",
    "test:debug": "node --expose-gc --max-old-space-size=1024 node_modules/.bin/jest --runInBand --detectOpenHandles --logHeapUsage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.78.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "node-schedule": "^2.1.1",
    "nodemailer": "^8.0.10",
    "pg": "^8.11.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "resend": "^6.4.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tree-sitter": "^0.22.0",
    "tree-sitter-cpp": "^0.23.4"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "pino-pretty": "^11.3.0"
  }
}
